# Copiar a .env y completar (deploy/install.sh lo crea solo, con secretos aleatorios). Nunca subir .env al repo.
# Formato: CLAVE=valor o CLAVE='valor' (sin comillas simples dentro del valor). Sin comentarios al final de línea.
# Tras cambiar un valor: docker compose up -d  (restart NO relee este archivo).

# --- Dominio y HTTPS (Caddy pide el certificado a Let's Encrypt para DOMAIN) ---
DOMAIN=tu-dominio.com
ACME_EMAIL=admin@tu-dominio.com
APP_BASE_URL=https://tu-dominio.com

# --- Secretos (install.sh los genera; ver docs/OPERACIONES.md para rotarlos) ---
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio-de-al-menos-32-caracteres
DB_USER=qiao
DB_PASSWORD=cambiar
MYSQL_ROOT_PASSWORD=cambiar
# Clave que usa el socio chino para leer y confirmar liquidaciones (≥ 32 caracteres; vacía = API desactivada)
PARTNER_API_KEY=cambiar-por-una-clave-larga
# Primer administrador (se crea sólo si no existe ninguno)
ADMIN_BOOTSTRAP_EMAIL=admin@tu-dominio.com
ADMIN_BOOTSTRAP_PASSWORD=cambiar-por-una-clave-de-12+caracteres

# Comisión de la plataforma sobre el costo del talento (%)
PLATFORM_FEE_PCT=25
# Razones sociales que aparecen en los contratos (sin ellas salen marcadores entre corchetes)
# APP_CONTRACTS_HK_ENTITY_NAME=Qiao Bridge (HK) Limited
# APP_CONTRACTS_PARTNER_ENTITY_NAME=Nombre legal del socio en China

# --- Email: log (sólo registra en el Outbox del back-office) o smtp (Alibaba DirectMail, puerto 465) ---
MAIL_MODE=smtp
SMTP_HOST=smtpdm-ap-southeast-1.aliyun.com
SMTP_PORT=465
SMTP_USER=no-reply@tu-dominio.com
SMTP_PASSWORD=cambiar
SMTP_FROM=no-reply@tu-dominio.com

# --- Pagos: fake (pruebas, NUNCA en producción real) o stripe (cuenta de la Ltd de Hong Kong) ---
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_live_o_sk_test
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Sólo para pruebas contra stripe-mock; en producción dejar vacío (el backend rechaza otro valor que no sea https://api.stripe.com)
STRIPE_API_BASE=

# --- Archivos subidos: local (volumen "files" del servidor) u oss (Alibaba OSS de Hong Kong) ---
STORAGE=local
OSS_ENDPOINT=https://oss-cn-hongkong.aliyuncs.com
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# --- Variante de despliegue (docker compose lee COMPOSE_FILE y COMPOSE_PROFILES de este archivo) ---
# Imágenes de CI desde Alibaba ACR en lugar de compilar en el servidor:
# COMPOSE_FILE=docker-compose.yml:docker-compose.images.yml
# Uptime Kuma en 127.0.0.1:3001:
# COMPOSE_PROFILES=monitoring
QIAO_REGISTRY=registry-vpc.cn-hongkong.aliyuncs.com
QIAO_NAMESPACE=
# Versión desplegada: la escribe deploy/update.sh (no editar a mano)
QIAO_IMAGE_TAG=local

# --- Backups (deploy/backup.sh, todos los días a las 03:30 hora de Hong Kong) ---
BACKUP_DIR=/var/backups/qiao
BACKUP_KEEP=14
# Copia externa en Alibaba OSS (API compatible con S3, vía rclone). Vacío = sólo copias locales.
# Usar un bucket propio para backups y un usuario RAM con permisos sólo sobre ese bucket (ver OPERACIONES.md).
BACKUP_OSS_BUCKET=
BACKUP_OSS_ENDPOINT=oss-cn-hongkong-internal.aliyuncs.com
BACKUP_OSS_PREFIX=qiao
BACKUP_OSS_ACCESS_KEY_ID=
BACKUP_OSS_ACCESS_KEY_SECRET=
