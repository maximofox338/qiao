# Copiar a .env y completar. Nunca subir .env al repositorio.
APP_BASE_URL=https://tu-dominio.com
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio-de-al-menos-32-caracteres
DB_USER=qiao
DB_PASSWORD=cambiar
MYSQL_ROOT_PASSWORD=cambiar
# Comisión de la plataforma sobre el costo del talento (%)
PLATFORM_FEE_PCT=25
# Email: log (sólo registra) o smtp (Alibaba DirectMail: smtpdm.aliyun.com, puerto 465)
MAIL_MODE=smtp
SMTP_HOST=smtpdm-ap-southeast-1.aliyun.com
SMTP_PORT=465
SMTP_USER=no-reply@tu-dominio.com
SMTP_PASSWORD=cambiar
SMTP_FROM=no-reply@tu-dominio.com
# Pagos: fake (pruebas) o stripe (cuenta de la Ltd de Hong Kong)
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_live_o_sk_test
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Archivos: local (volumen del servidor) u oss (Alibaba OSS de Hong Kong)
STORAGE=local
OSS_ENDPOINT=https://oss-cn-hongkong.aliyuncs.com
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# Clave que usa el socio chino para leer y confirmar liquidaciones
PARTNER_API_KEY=cambiar-por-una-clave-larga
# Primer administrador (se crea sólo si no existe ninguno)
ADMIN_BOOTSTRAP_EMAIL=admin@tu-dominio.com
ADMIN_BOOTSTRAP_PASSWORD=cambiar-por-una-clave-de-12+caracteres
